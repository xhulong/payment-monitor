# 对外管理端口；后续域名反代指向此端口。
ADMIN_BIND_HOST=0.0.0.0
ADMIN_PORT=18081

# 后端仅监听本机，供同机反向代理或诊断使用。
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=18082
PAYMENT_PUBLIC_BASE_URL=http://your-server-ip:18081

DB_PASSWORD=replace-with-strong-database-password
REDIS_PASSWORD=replace-with-strong-redis-password
SA_TOKEN_JWT_SECRET=replace-with-at-least-32-random-characters
PAYMENT_MASTER_KEY=replace-with-at-least-32-random-characters
PAYMENT_INTEGRATION_ACTIVE_KEY_ID=payment-integration-2026-01
PAYMENT_INTEGRATION_MASTER_KEY=replace-with-separate-random-integration-master-key
ACCOUNT_MFA_MASTER_KEY=replace-with-at-least-32-random-characters
ACCOUNT_RECOVERY_CODE_PEPPER=replace-with-at-least-32-random-characters
MAIL_OUTBOX_MASTER_KEY=replace-with-at-least-32-random-characters
MAIL_OUTBOX_ACTIVE_KEY_ID=mail-outbox-2026-01
APK_DOWNLOAD_SIGNING_SECRET=replace-with-at-least-32-random-characters
MONITOR_PASSWORD=replace-with-strong-monitor-password

MINIO_ROOT_USER=paymentmonitor
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
MINIO_BUCKET=payment-monitor-private

API_CRYPTO_V2_ENABLED=true
API_CRYPTO_V2_ACTIVE_KID=payment-monitor-rsa-2026-01
API_CRYPTO_V2_PUBLIC_KEY_HOST_FILE=/opt/payment-monitor/config/secrets/api-crypto-v2-public.pem
API_CRYPTO_V2_PRIVATE_KEY_HOST_FILE=/opt/payment-monitor/config/secrets/api-crypto-v2-private.pem

PAYMENT_RAW_PAYLOAD_UPLOAD_ENABLED=false
PAYMENT_WEBHOOK_ENABLED=true
PAYMENT_WEBHOOK_ALLOW_HTTP=false
PAYMENT_WEBHOOK_ALLOW_PRIVATE_NETWORK=false
PAYMENT_EASYPAY_ENABLED=true
PAYMENT_EASYPAY_ALLOW_HTTP=false
PAYMENT_EASYPAY_ALLOW_PRIVATE_NETWORK=false
PAYMENT_EASYPAY_REQUIRE_HTTPS_QUERY=true
PAYMENT_MERCHANT_API_RATE_LIMIT_PER_MINUTE=120
PAYMENT_AGREEMENT_VERSION=2026-07
PAYMENT_PRIVACY_VERSION=2026-07

ANDROID_EXPECTED_PACKAGE_NAME=com.xhulong.paymentmonitor
ANDROID_EXPECTED_SIGNING_CERTIFICATE_SHA256=

# 直接通过 HTTP 端口调试时为 false；域名 HTTPS 反代完成后改为 true 并重新构建。
AUTH_REFRESH_COOKIE_SECURE=false

SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_FROM=noreply@localhost
SMTP_USERNAME=noreply@localhost
SMTP_PASSWORD=disabled
SMTP_STARTTLS_ENABLE=false
SMTP_SSL_ENABLE=false

BACKEND_IMAGE=payment-monitor-backend:latest
ADMIN_IMAGE=payment-monitor-admin:latest
JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+HeapDumpOnOutOfMemoryError
